# Local single-user application. Keep the server bound to loopback.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/wayfinder.sqlite
SEED_DEMO=true
# Amadeus test data is NOT live inventory. Switch to production with approved keys.
AMADEUS_ENV=test
# Run scripts/configure-integrations.ps1 to encrypt API credentials with DPAPI.
# You can also inject secrets via process environment or your deployment secret manager.
CONFIG_VAULT_FILE=./.secrets/integrations.json
# Flexible searches are bounded to prevent unexpected API costs.
MAX_SEARCH_VARIANTS=25
# Optional AI: both key and a Structured Outputs compatible model are required.
OPENAI_MODEL=
# Optional external POIs, otherwise explicitly labeled sample Tokyo/Osaka/Seoul data.
# Isolated automation profile; never points at your personal Edge profile.
BROWSER_CHANNEL=msedge
# Google Flights live searches need Edge, no API key. Requests are serialized,
# spaced 5 seconds apart, cached for 60 seconds, and stop for 4 hours on a block.
