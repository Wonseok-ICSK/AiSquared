# =============================================================================
# AiSquared Travel - Python backend (backend/app/config.py, DESIGN.md section 8)
# Copy to travel-planner/.env. Every value is optional; defaults are shown.
# Secrets can instead be entered in the web UI (Settings), where they are stored
# encrypted; a value saved in the UI overrides the one here.
# =============================================================================

# Port the backend is served on (used for local self-links, e.g. the default
# Kakao redirect URI). Default: 8765
BACKEND_PORT=8765

# Runtime data directory (SQLite DB, browser profiles, sessions, logs).
# Relative paths are resolved against travel-planner/. Default: travel-planner/data
DATA_DIR=
# SQLAlchemy URL. Default: sqlite:///<DATA_DIR>/app.db
DATABASE_URL=
# IANA timezone for schedules and local display.
TIMEZONE=Asia/Seoul
# Default currency for new trips and budgets (ISO 4217).
DEFAULT_CURRENCY=KRW
# Run browsers without a window (login flows always open a visible window).
BROWSER_HEADLESS=true
# Start the in-process monitoring scheduler.
SCHEDULER_ENABLED=true
# Upper bound on (date x airport) combinations searched per trip check.
MAX_SEARCH_COMBINATIONS=12

# --- AI itinerary (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=xhigh

# --- Flight / place data providers ---
# SerpApi (Google Flights results)
SERPAPI_API_KEY=
# Google Maps Platform (Places) for itinerary candidates
GOOGLE_MAPS_API_KEY=

# --- Email notifications (SMTP with STARTTLS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# For Gmail use an App Password, never your account password.
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipient list
SMTP_TO=
SMTP_STARTTLS=true

# --- KakaoTalk "send to me" notifications (Kakao Developers app) ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Must match a Redirect URI registered in the Kakao app.
KAKAO_REDIRECT_URI=http://127.0.0.1:8765/api/integrations/kakao/callback

# --- Telegram bot notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
